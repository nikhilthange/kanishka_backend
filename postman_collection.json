		{
			"name": "4. Authorization Failures (RBAC Enforcement)",
			"item": [
				{
					"name": "FAIL: Regular User Updates Task Status (403 Forbidden)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{userToken}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"Completed\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tasks/{{createdTaskId}}/status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tasks", "{{createdTaskId}}", "status"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Forbidden 403 returned when regular user attempts to update status\", function () {",
									"    pm.response.to.have.status(403);",
									"    var data = pm.response.json();",
									"    pm.expect(data.detail).to.include(\"Regular users are not authorized to update task status\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "FAIL: Regular User Modifies Another User's Task (403 Forbidden)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
