						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Unauthorized Modification Attempt\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tasks/6",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tasks", "6"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Forbidden 403 returned when modifying another user's task\", function () {",
									"    pm.response.to.have.status(403);",
									"    var data = pm.response.json();",
									"    pm.expect(data.detail).to.include(\"You cannot modify tasks belonging to other users\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
